{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/snsnnd/NN_Car/schema/run_log.schema.json",
  "title": "NN_Car run manifest",
  "description": "Manifest written next to every CSV run log. The CSV contract lives in x-csv so a single file describes both artifacts.",
  "type": "object",
  "required": [
    "schema_version",
    "generator",
    "profile",
    "profile_version",
    "seed",
    "tick_dt_s",
    "line_dt_s",
    "scenario"
  ],
  "additionalProperties": true,
  "properties": {
    "schema_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "generator": { "type": "string", "minLength": 1 },
    "profile": { "type": "string", "minLength": 1 },
    "profile_version": { "type": "string", "minLength": 1 },
    "profile_verified": { "type": "boolean" },
    "seed": { "type": "integer", "minimum": 0 },
    "git_commit": { "type": "string" },
    "tick_dt_s": { "type": "number", "exclusiveMinimum": 0 },
    "line_dt_s": { "type": "number", "exclusiveMinimum": 0 },
    "vehicle": {
      "type": "object",
      "required": ["wheel_radius_m", "track_width_m", "sensor_count", "sensor_to_axle_m", "sensor_position_m"],
      "properties": {
        "wheel_radius_m": { "type": "number", "exclusiveMinimum": 0 },
        "track_width_m": { "type": "number", "exclusiveMinimum": 0 },
        "sensor_count": { "type": "integer", "minimum": 1, "maximum": 16 },
        "sensor_to_axle_m": { "type": "number" },
        "sensor_position_m": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "type": "number" } }
      }
    },
    "simulation": {
      "type": "object",
      "required": ["track_model", "line_width_m", "motor_model", "motor_inertia_kgm2", "motor_damping_nms", "motor_torque_gain_nm", "motor_stiction_nm", "gray_model", "gray_noise_std", "gray_offset", "gray_gain", "gray_valid_prob", "gray_missing_mask"],
      "properties": {
        "track_model": { "type": "string" },
        "line_width_m": { "type": "number", "exclusiveMinimum": 0 },
        "motor_model": { "type": "string" },
        "motor_inertia_kgm2": { "type": "number", "exclusiveMinimum": 0 },
        "motor_damping_nms": { "type": "number", "exclusiveMinimum": 0 },
        "motor_torque_gain_nm": { "type": "number", "minimum": 0 },
        "motor_stiction_nm": { "type": "number", "minimum": 0 },
        "gray_model": { "type": "string" },
        "gray_noise_std": { "type": "number", "minimum": 0 },
        "gray_offset": { "type": "number", "minimum": -1, "maximum": 1 },
        "gray_gain": { "type": "number", "minimum": 0, "maximum": 2 },
        "gray_valid_prob": { "type": "number", "minimum": 0, "maximum": 1 },
        "gray_missing_mask": { "type": "integer", "minimum": 0, "maximum": 65535 }
      }
    },
    "scenario": {
      "type": "object",
      "required": ["duration_s", "v_desired_mps", "rail_v"],
      "properties": {
        "duration_s": { "type": "number", "exclusiveMinimum": 0 },
        "v_desired_mps": { "type": "number", "minimum": 0 },
        "offset_m": { "type": "number" },
        "heading_deg": { "type": "number" },
        "amp_m": { "type": "number" },
        "wavelength_m": { "type": "number", "exclusiveMinimum": 0 },
        "rail_v": { "type": "number", "minimum": 0 }
      }
    }
  },
  "x-csv": {
    "delimiter": ",",
    "required_columns": [
      "t_us", "mode", "line_conf", "line_centroid_m", "line_found", "valid_count",
      "v_target", "omega_target", "v_max_eff", "lambda", "kappa_target",
      "wheel_v_l_target", "wheel_v_r_target", "wheel_v_l", "wheel_v_r",
      "u_l", "u_r", "pwm_l", "pwm_r", "v_rail", "v_rail_valid",
      "safety_faults", "safety_latched", "safety_derate", "safety_ramp",
      "safety_stop", "x", "y", "theta", "recovery_ms"
    ],
    "integer_columns": [
      "t_us", "mode", "line_found", "valid_count", "v_rail_valid",
      "safety_faults", "safety_latched", "safety_stop"
    ],
    "optional_sensor_channels": {
      "count": 16,
      "value_prefix": "gray_value_",
      "exist_prefix": "gray_exist_",
      "valid_prefix": "gray_valid_",
      "value_range": [-1.0, 1.0]
    },
    "flags": {
      "mode": [0, 1],
      "line_found": [0, 1],
      "v_rail_valid": [0, 1],
      "safety_latched": [0, 1],
      "safety_stop": [0, 1]
    },
    "ranges": {
      "line_conf": [0.0, 1.0],
      "lambda": [0.0, 1.0],
      "safety_derate": [0.0, 1.0],
      "safety_ramp": [0.0, 1.0],
      "u_l": [-1.0, 1.0],
      "u_r": [-1.0, 1.0],
      "pwm_l": [-1.0, 1.0],
      "pwm_r": [-1.0, 1.0],
      "v_max_eff": [0.0, 3.0],
      "v_target": [0.0, 3.0],
      "omega_target": [-20.0, 20.0],
      "wheel_v_l_target": [-3.0, 3.0],
      "wheel_v_r_target": [-3.0, 3.0],
      "wheel_v_l": [-3.0, 3.0],
      "wheel_v_r": [-3.0, 3.0],
      "v_rail": [0.0, 20.0],
      "kappa_target": [-20.0, 20.0],
      "line_centroid_m": [-0.2, 0.2],
      "recovery_ms": [0.0, 10000.0]
    },
    "monotonic": {
      "t_us": "strictly_increasing"
    }
  }
}
