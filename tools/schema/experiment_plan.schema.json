{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "NN_Car experiment plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "name", "cases"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "scenario", "seeds"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "description": {"type": "string"},
          "seeds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "integer", "minimum": 0, "maximum": 4294967295}
          },
          "scenario": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "duration_s": {"type": "number", "exclusiveMinimum": 0},
              "v_desired_mps": {"type": "number", "minimum": 0},
              "offset_m": {"type": "number"},
              "heading_deg": {"type": "number"},
              "amp_m": {"type": "number"},
              "wavelength_m": {"type": "number", "exclusiveMinimum": 0},
              "map_file": {"type": ["string", "null"]},
              "rail_v": {"type": "number", "exclusiveMinimum": 0},
              "line_width_m": {"type": "number", "exclusiveMinimum": 0},
              "motor_inertia_kgm2": {"type": "number", "exclusiveMinimum": 0},
              "motor_damping_nms": {"type": "number", "exclusiveMinimum": 0},
              "motor_torque_gain_nm": {"type": ["number", "null"], "minimum": 0},
              "motor_stiction_nm": {"type": "number", "minimum": 0},
              "gray_noise_std": {"type": "number", "minimum": 0},
              "gray_offset": {"type": "number", "minimum": -1, "maximum": 1},
              "gray_gain": {"type": "number", "minimum": 0, "maximum": 2},
              "gray_valid_prob": {"type": "number", "minimum": 0, "maximum": 1},
              "gray_missing_mask": {"type": "integer", "minimum": 0, "maximum": 65535}
            }
          }
        }
      }
    }
  }
}
