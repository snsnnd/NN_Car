{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "NN_Car polyline track map",
  "type": "object",
  "additionalProperties": false,
  "required": ["map_version", "name", "units_per_meter", "start", "nodes", "edges"],
  "properties": {
    "map_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "name": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"},
    "description": {"type": "string"},
    "source": {"type": "string"},
    "units_per_meter": {"type": "number", "exclusiveMinimum": 0},
    "line_width_m": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
    "start": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node"],
      "properties": {
        "node": {"type": "integer", "minimum": 0},
        "toward": {"type": "integer", "minimum": 0},
        "heading_deg": {"type": "number"}
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "array",
        "minItems": 3,
        "maxItems": 3,
        "items": [
          {"type": "integer", "minimum": 0},
          {"type": "number"},
          {"type": "number"}
        ],
        "additionalItems": false
      }
    },
    "edges": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": {"type": "integer", "minimum": 0}
      }
    }
  }
}
